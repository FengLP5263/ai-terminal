* text=auto
*.rs text eol=lf
*.toml text eol=lf
Cargo.lock text eol=lf
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf whitespace=cr-at-eol
*.ttf binary
*.png binary
*.ico binary
assets/windows/conpty/x64/*.dll binary
assets/windows/conpty/x64/*.exe binary
assets/windows/conpty/LICENSE.txt -text whitespace=cr-at-eol
# Preserve published upstream streams and original font-license bytes.
vendor/alacritty_terminal/** -text
vendor/vte/** -text
vendor/alacritty_terminal/UPSTREAM*.md text eol=lf
vendor/vte/UPSTREAM*.md text eol=lf
vendor/alacritty_terminal/tests/ref/**/*.recording binary
assets/fonts/LICENSE-Cascadia.txt -text -whitespace

# Preserve the original installer-toolchain license bytes.
scripts/installer/NSIS-LICENSE.txt -text -whitespace
assets/fonts/LICENSE-JetBrainsMono.txt -text -whitespace
